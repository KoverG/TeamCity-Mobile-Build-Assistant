{
  "manifest_version": 3,
  "name": "TeamCity Mobile Build Assistant",
  "version": "1.2.0",
  "description": "Find, open, download, and copy links to mobile TeamCity artifacts.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open TeamCity Mobile Build Assistant"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*.png", "assets/*.svg", "assets/*.woff2"],
      "matches": ["https://*/*"]
    }
  ]
}
